# ===== Application =====
# Use "production" only after setting a strong SESSION_SECRET.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
SESSION_SECRET=generated-by-dev-script
TIMEZONE=Asia/Shanghai

# ===== Database =====
# The default SQLite file is data/assistant-v1.db in the project root.
# Set DATABASE_URL only to override that location.
AUTO_CREATE_SCHEMA=true

# ===== LLM provider =====
# The mock provider works without a key. To use a real model, switch to
# openai-compatible and fill all three values below, or configure a personal
# ModelScope key from the Settings page after startup.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Optional dedicated model for automatic group-chat replies.
GROUP_LLM_BASE_URL=
GROUP_LLM_API_KEY=
GROUP_LLM_MODEL=

# ===== Concurrency and background jobs =====
MAX_GLOBAL_RUNS=4
MAX_ACTIVE_RUNS_PER_USER=2
MESSAGE_RATE_LIMIT_PER_MINUTE=20
REMINDER_POLL_SECONDS=5
RUN_EVENT_RETENTION_SECONDS=3600
